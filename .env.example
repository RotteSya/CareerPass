# ── GooJob server ────────────────────────────────────────────
PORT=3000

# Encrypts IMAP passwords at rest (AES-256-GCM). Set any long random string.
APP_SECRET=change-me-to-a-long-random-string

# ── Bot channels (all optional — without them the console bot is used) ──
# Telegram: create a bot via @BotFather, paste the token. Works locally
# out of the box (long polling, no public URL needed).
TELEGRAM_BOT_TOKEN=

# LINE: requires a public URL for the webhook (deploy first), then set
# the webhook to  https://<your-host>/webhooks/line
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── Intelligence (optional) ──────────────────────────────────
# With a key, Claude refines email understanding and writes company briefs.
# Without it, the rule-based pipeline still works end to end.
ANTHROPIC_API_KEY=

# ── Demo mode ────────────────────────────────────────────────
# DEMO=1 enables /demo playground, sample-mail injection and compressed
# reminder timing (no real credentials needed). Or just run `npm run demo`.
DEMO=
